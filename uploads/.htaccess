# Chặn thực thi các file mã nguồn động trong thư mục upload
<FilesMatch "(?i)\.(php|php3|php4|php5|phtml|pl|py|cgi|asp|aspx|sh|bat)$">
    Order Deny,Allow
    Deny from all
</FilesMatch>

# Vô hiệu hóa PHP Engine
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>
