# Chặn thực thi mã động trong thư mục upload, tương thích Apache 2.2 và Apache 2.4 trên InfinityFree
<FilesMatch "(?i)\.(php|php3|php4|php5|phtml|pl|py|cgi|asp|aspx|sh|bat)$">
    <IfModule !mod_authz_core.c>
        Order Deny,Allow
        Deny from all
    </IfModule>
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</FilesMatch>
